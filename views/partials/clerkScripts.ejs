<script>
  (function() {
    var pk = "<%= clerkPublishableKey %>";
    if (!pk || pk === "your_publishable_key_here") {
      console.warn("Clerk: No valid publishable key set. Auth components will not load.");
      return;
    }

    // Decode the FAPI domain from the publishable key
    // pk_test_<base64(domain + $)> → extract domain for CDN URL
    var encoded = pk.replace("pk_test_", "").replace("pk_live_", "");
    try {
      var decoded = atob(encoded);
      var fapiDomain = decoded.replace(/\$$/, ""); // remove trailing $
    } catch(e) {
      console.error("Clerk: Could not decode publishable key");
      return;
    }

    var scriptUrl = "https://" + fapiDomain + "/npm/@clerk/clerk-js@latest/dist/clerk.browser.js";

    var script = document.createElement("script");
    script.src = scriptUrl;
    script.crossOrigin = "anonymous";
    script.setAttribute("data-clerk-publishable-key", pk);
    script.async = true;

    script.addEventListener("load", function() {
      if (window.Clerk) {
        window.Clerk.load().then(function() {
          console.log("Clerk initialized successfully");
          window.dispatchEvent(new Event("clerk-ready"));
        }).catch(function(err) {
          console.error("Clerk load error:", err);
        });
      }
    });

    script.addEventListener("error", function() {
      console.error("Failed to load Clerk script from:", scriptUrl);
    });

    document.head.appendChild(script);
  })();
</script>
