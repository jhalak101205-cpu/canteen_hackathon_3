<script>
  (function() {
    var pk = "<%= clerkPublishableKey %>";
    if (!pk || pk === "your_publishable_key_here") {
      console.warn("Clerk: No valid publishable key set.");
      return;
    }

    var scriptUrl = "https://cdn.jsdelivr.net/npm/@clerk/clerk-js@latest/dist/clerk.browser.js";

    var script = document.createElement("script");
    script.src = scriptUrl;
    script.crossOrigin = "anonymous";
    script.setAttribute("data-clerk-publishable-key", pk);
    script.async = true;

    script.addEventListener("load", function() {
      if (window.Clerk) {
        window.Clerk.load({
          publishableKey: pk
        }).then(function() {
          console.log("Clerk initialized successfully");
          window.clerkReady = true;
          window.dispatchEvent(new Event("clerk-ready"));
        }).catch(function(err) {
          console.error("Clerk load error:", err);
        });
      }
    });

    script.addEventListener("error", function(err) {
      console.error("Failed to load Clerk script from CDN:", err);
    });

    document.head.appendChild(script);
  })();
</script>
