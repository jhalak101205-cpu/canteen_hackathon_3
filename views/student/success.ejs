<%- include("../partials/header") %>
<%- include("../partials/navbar") %>

<main class="student-layout">
    <div class="container" style="display: flex; align-items: center; justify-content: center; min-height: calc(100vh - var(--header-height) - 150px);">
        <div class="success-card">
            <div class="success-icon-container">
                <div class="success-checkmark">✓</div>
            </div>
            
            <h1 style="font-size: 28px; margin-bottom: 12px; font-weight: 800;">Order Placed Successfully!</h1>
            <p style="color: var(--text-muted); font-size: 15px; max-width: 400px; margin: 0 auto;">
                Your request has been received by the canteen staff. Please present your token at the counter or wait at your table.
            </p>
            
            <!-- Token Box -->
            <div class="success-token-badge">
                <div class="success-token-label">Your Digital Token</div>
                <!-- Token number placeholder -->
                <div class="success-token-number" id="tokenPlaceholder">T-742</div>
            </div>
            
            <!-- Details & Status Tracker -->
            <div class="success-details">
                <div class="success-detail-row">
                    <span>Order Status</span>
                    <!-- Order status placeholder -->
                    <span style="font-weight: 700; color: var(--secondary);" id="statusPlaceholder">Preparing</span>
                </div>
                <div class="success-detail-row">
                    <span>Estimated Time</span>
                    <span style="font-weight: 600;" id="timerPlaceholder">8-10 Mins</span>
                </div>
                <div class="success-detail-row">
                    <span>Delivery Mode</span>
                    <span style="font-weight: 600;">Table 4</span>
                </div>
            </div>
            
            <!-- Backend route will be added here -->
            <a href="/menu" class="success-btn">
                🍽️ Back to Menu
            </a>
        </div>
    </div>
</main>

<!-- Load Socket.io Client -->
<script src="/socket.io/socket.io.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const urlParams = new URLSearchParams(window.location.search);
        let token = urlParams.get('token');
        let orderId = urlParams.get('orderId');
        let initialStatus = urlParams.get('status') || 'pending';
        
        if (!token) {
            // Fallback to random if not present
            token = 'T-' + Math.floor(1000 + Math.random() * 9000);
        }
        
        document.getElementById('tokenPlaceholder').innerText = token;
        
        const statusEl = document.getElementById('statusPlaceholder');
        const timerEl = document.getElementById('timerPlaceholder');
        
        function updateStatusUI(status) {
            const lowerStatus = status.toLowerCase();
            if (lowerStatus === 'pending') {
                statusEl.innerText = "Pending ⏳";
                statusEl.style.color = "var(--primary)";
                timerEl.innerText = "Waiting for canteen confirmation";
            } else if (lowerStatus === 'preparing') {
                statusEl.innerText = "Preparing 🍳";
                statusEl.style.color = "var(--secondary)";
                timerEl.innerText = "5-10 mins remaining";
            } else if (lowerStatus === 'ready') {
                statusEl.innerText = "Food Ready! 😋";
                statusEl.style.color = "var(--accent)";
                timerEl.innerText = "Please pick up at counter";
            } else if (lowerStatus === 'delivered' || lowerStatus === 'completed') {
                statusEl.innerText = "Delivered! 🎉";
                statusEl.style.color = "var(--accent)";
                timerEl.innerText = "Enjoy your meal!";
            } else if (lowerStatus === 'cancelled') {
                statusEl.innerText = "Cancelled ❌";
                statusEl.style.color = "var(--text-muted)";
                timerEl.innerText = "Order cancelled";
            } else {
                statusEl.innerText = status;
                statusEl.style.color = "var(--primary)";
                timerEl.innerText = "Checking status...";
            }
        }
        
        updateStatusUI(initialStatus);
        
        // Connect to socket.io
        try {
            const socket = io();
            socket.on('connect', () => {
                console.log('Connected to server via WebSockets');
            });
            
            // Listen to updates for this specific token
            socket.on(`order-status-${token}`, (data) => {
                console.log('Received order status update:', data);
                if (data && data.status) {
                    updateStatusUI(data.status);
                }
            });
        } catch (err) {
            console.error('Socket connection error:', err);
        }
    });
</script>

<%- include("../partials/footer") %>
